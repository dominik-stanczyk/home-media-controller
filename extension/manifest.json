{
  "manifest_version": 3,
  "name": "Home Media Remote",
  "version": "1.0",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://open.spotify.com/*",
    "https://spotify.com/*",
    "https://*.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://spotify.com/*",
        "https://*.spotify.com/*"
      ],
      "js": ["spotify.js"],
      "run_at": "document_idle"
    }
  ]
}
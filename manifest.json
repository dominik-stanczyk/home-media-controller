{
  "manifest_version": 3,
  "name": "YT Remote",
  "version": "1.3",

  "permissions": [
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "http://192.168.1.110:5000/*",
    "*://*.youtube.com/*",
    "*://*.spotify.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.spotify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}